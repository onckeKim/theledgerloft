# The Ledger Loft: environment variables
# Copy to .env.local and fill in. Never commit real values.
# Variables are added here as each build step introduces them.

# --- Supabase (added in step A4) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose to the browser

# --- PayFast (added in step L9, sandbox first) ---
# PAYFAST_MODE=sandbox
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=               # server-only
