# The Ledger Loft: environment variables
# Copy to .env.local and fill in. Never commit real values.
# Every variable here is validated in src/lib/env.ts; add new ones in both places.

# --- App (A3) ---
# Public base URL. Required in production (e.g. https://app.example.co.za).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Development only: "synthetic" lets you view signed-in screens without an account.
# Refused in production. Removed once Supabase Auth lands (A4).
APP_PREVIEW=off

# --- Supabase (added in step A4) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose to the browser

# --- PayFast (added in step L9, sandbox first) ---
# PAYFAST_MODE=sandbox
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=               # server-only
